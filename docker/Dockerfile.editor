FROM node:20-alpine AS builder

WORKDIR /app

# Instalar pnpm
RUN npm install -g pnpm@10.9.0

# Copiar package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/editor/package.json ./packages/editor/

# Instalar dependências
RUN pnpm install --frozen-lockfile

# Copiar código fonte
COPY packages/shared ./packages/shared
COPY packages/editor ./packages/editor

# Build shared primeiro
RUN pnpm --filter @ine/shared build

# Vite lê env apenas em build time
ARG VITE_API_URL=http://localhost:3001
ARG VITE_PLAYER_URL=http://localhost:5173
ARG VITE_MEDIA_URL=http://localhost:3001
ARG VITE_UPLOAD_API_URL=http://localhost:3001
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_PLAYER_URL=$VITE_PLAYER_URL
ENV VITE_MEDIA_URL=$VITE_MEDIA_URL
ENV VITE_UPLOAD_API_URL=$VITE_UPLOAD_API_URL

# Build do editor (nome do pacote é 'editor', não '@ine/editor')
RUN pnpm --filter editor build

# Produção com Nginx
FROM nginx:alpine
COPY --from=builder /app/packages/editor/dist /usr/share/nginx/html
COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
