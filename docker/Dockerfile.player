FROM node:20-alpine AS builder

WORKDIR /app

# Instalar pnpm
RUN npm install -g pnpm

# Copiar package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/player/package.json ./packages/player/

# Instalar dependências
RUN pnpm install --frozen-lockfile

# Copiar código fonte
COPY packages/shared ./packages/shared
COPY packages/player ./packages/player

# Build shared primeiro
RUN pnpm --filter @ine/shared build

# Vite lê env apenas em build time
ARG VITE_API_URL=http://localhost:3001
ENV VITE_API_URL=$VITE_API_URL

# Build do player (nome do pacote é 'player', não '@ine/player')
RUN pnpm --filter player build

# Produção com Nginx
FROM nginx:alpine
COPY --from=builder /app/packages/player/dist /usr/share/nginx/html
COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
