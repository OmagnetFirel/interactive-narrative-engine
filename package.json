{
  "name": "interactive-narrative-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:editor": "pnpm --filter @ine/editor dev",
    "dev:api": "pnpm --filter @ine/api dev",
    "dev:player": "pnpm --filter @ine/player dev",
    "build": "pnpm --filter './packages/*' build",
    "clean": "pnpm --filter './packages/*' exec rm -rf dist node_modules"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}