# ===========================================
# Interactive Narrative Engine - Environment
# ===========================================

# API Configuration
NODE_ENV=development
PORT=3001

# Database
# API fora do Docker (host): use porta publicada do compose (5433 por padrão)
DATABASE_URL=postgresql://ine_user:ine_password@localhost:5433/ine_database

# Paths
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false

# Limites da demo
MAX_AUTHORS=5
MAX_PROJECTS_PER_USER=3
MAX_UPLOAD_BYTES_PER_USER=5368709120
RATE_LIMIT_GENERAL=300
RATE_LIMIT_INVITES=20
RATE_LIMIT_PUBLIC_EXPENSIVE=60

# Auth e bootstrap do primeiro administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
JWT_SECRET=change-me-to-a-long-random-secret
COOKIE_SECURE=false

# URL pública do player (usada para gerar links de compartilhamento)
PUBLIC_API_URL=http://localhost:3001
PUBLIC_MEDIA_URL=http://localhost:3001
PUBLIC_PLAYER_URL=http://localhost:5173
PUBLIC_EDITOR_URL=http://localhost:3000
